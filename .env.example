APP_NAME=LLM Paper RAG Assistant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=llm_papers
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=0.3
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_MODEL=
ENABLE_HYBRID_SEARCH=true
ENABLE_KEYWORD_RERANK=true
RERANKER_PROVIDER=rule
RERANK_CANDIDATE_MULTIPLIER=3
KEYWORD_CANDIDATE_LIMIT=30
USE_INFERENCE_GATEWAY=false
INFERENCE_GATEWAY_BASE_URL=http://127.0.0.1:8010
INFERENCE_GATEWAY_API_KEY=dev-local-key
